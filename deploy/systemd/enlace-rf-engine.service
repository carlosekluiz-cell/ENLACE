[Unit]
Description=Enlace RF propagation engine (Rust gRPC :50051)
After=network.target

[Service]
User=dev
Group=dev
WorkingDirectory=/home/dev/enlace
Environment=SRTM_TILE_DIR=/home/dev/enlace/data/terrain/dtm
Environment=DSM_TILE_DIR=/home/dev/enlace/data/terrain/dsm
Environment=GROUND_TILE_DIR=/home/dev/enlace/data/terrain/ground
Environment=RF_ENGINE_ADDR=127.0.0.1:50051
ExecStart=/home/dev/enlace/rust/target/release/pulso-rf-engine
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
