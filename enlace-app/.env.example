# pulso-agent audit HTTP server (POST /audit, GET /audit/:id).
# The agent binds 127.0.0.1 — this app proxies it via Next server routes.
PULSO_AUDIT_SERVER=http://127.0.0.1:8080
# Bearer token the agent printed at startup or that you set for it.
# Injected server-side only; never shipped to the browser.
PULSO_AUDIT_TOKEN=

# Elasticsearch for live NOC feeds (enlace-ont-{date}, enlace-faults-*).
# Leave unset to run on audit/demo data — the UI states this honestly.
ELASTIC_URL=
ELASTIC_API_KEY=

# ── App DB (SQLite, tenant-scoped schema) ──
# Created + migrated automatically; seed demo accounts with `npm run db:seed`.
ENLACE_APP_DB=./data/enlace-app.db

# ── Auth (in-house JWT issuer, docs/ARCHITECTURE-TENANCY.md §2.4) ──
# HS256 signing secret for the httpOnly `enlace_session` cookie (12 h TTL).
# REQUIRED in any real deployment. When unset, a dev-only secret is
# generated into ./data/auth-secret.dev and the server warns loudly.
ENLACE_AUTH_SECRET=

# ── Demo credentials (pilot demo — discoverability is a feature) ──
# Seeded by `npm run db:seed` into tenant "demo-operator". Also in README.md.
#   director@demo.enlace.network         demo-director          (admin,   Director)
#   network-manager@demo.enlace.network  demo-network-manager   (manager, Network Manager)
#   supervisor@demo.enlace.network       demo-supervisor        (manager, Supervisor)
#   noc-operator@demo.enlace.network     demo-noc-operator      (analyst, NOC Operator)
#   field-engineer@demo.enlace.network   demo-field-engineer    (viewer,  Field Engineer)

# ── Public app URL (WhatsApp dispatch deep links, Wave C1) ──
# Base URL this deployment is reachable at FROM A PHONE — used to build the
# shareable /field/ticket/... deep links inside wa.me messages. Build-time
# inlined on the client (NEXT_PUBLIC_*). Default: http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
