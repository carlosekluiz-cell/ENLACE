# pulso-agent audit HTTP server (POST /audit, GET /audit/:id).
# The agent binds 127.0.0.1 — this app proxies it via Next server routes.
PULSO_AUDIT_SERVER=http://127.0.0.1:8080
# Bearer token the agent printed at startup or that you set for it.
# Injected server-side only; never shipped to the browser.
PULSO_AUDIT_TOKEN=

# Elasticsearch for live NOC feeds (enlace-ont-{date}, enlace-faults-*).
# Leave unset to run on audit/demo data — the UI states this honestly.
ELASTIC_URL=
ELASTIC_API_KEY=
